# ---- Frontend (public, bundled into the browser) ----
# "mock" (default) = dùng mock service, không cần API key
# "api"            = gọi /api/reading (serverless function), key nằm ở server
VITE_READING_SOURCE=mock

# ---- Server only (KHÔNG có tiền tố VITE_, không bao giờ vào bundle frontend) ----
# Gemini (Google AI Studio, có free tier) — đang dùng. Lấy key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.6-flash (mặc định). Model khả dụng tùy key — xem trong AI Studio
GEMINI_MODEL=gemini-3.6-flash

# Groq — dự phòng khi Gemini hết lượt/quá tải (không bắt buộc). Lấy key free: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude (Anthropic) — tạm tắt, xem server/providers/claudeProvider.ts
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Kimi (Moonshot) — tạm tắt, xem server/providers/kimiProvider.ts
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3
